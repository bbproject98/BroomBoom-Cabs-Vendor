datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Vendor Leads Core Model
model VendorLead {
  id                String   @id @default(uuid())
  applicationId     String   @unique @map("application_id")
  fullName          String   @map("full_name")
  mobile            String
  alternatePhone    String?  @map("alternate_phone")
  email             String?
  state             String?
  city              String
  pincode           String?
  proposedAddress   String?  @map("proposed_address")
  spaceStatus       String?  @map("space_status")
  carpetArea        String?  @map("carpet_area")
  preferredPackage  String   @map("preferred_package")
  packageName       String?  @map("package_name")
  investmentBudget  String?  @map("investment_budget")
  financeRequired   String?  @default("Self-Funded / Ready Capital") @map("finance_required")
  loanAssistance    String?  @default("No (Self-Funded)") @map("loan_assistance")
  currentProfession String?  @map("current_profession")
  hasExperience     String?  @map("has_experience")
  message           String?
  source            String   @default("vendor_portal")
  status            String   @default("new")
  adminNotes        String?  @map("admin_notes")
  
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([city])
  @@index([preferredPackage])
  @@index([createdAt(sort: Desc)])
  @@map("vendor_leads")
}

// Franchise Leads (Preserved from Franchise Portal)
model FranchiseLead {
  id                String   @id @default(cuid())
  applicationId     String   @unique @map("application_id")
  fullName          String   @map("full_name")
  mobile            String
  alternatePhone    String?  @map("alternate_phone")
  email             String
  state             String?
  city              String
  pincode           String?
  proposedAddress   String?  @map("proposed_address")
  spaceStatus       String?  @map("space_status")
  carpetArea        String?  @map("carpet_area")
  preferredPackage  String   @map("preferred_package")
  packageName       String?  @map("package_name")
  investmentBudget  String?  @map("investment_budget")
  financeRequired   String?  @default("Self-Funded") @map("finance_required")
  loanAssistance    String?  @default("No") @map("loan_assistance")
  currentProfession String?  @map("current_profession")
  hasExperience     String?  @map("has_experience")
  message           String?
  source            String?  @default("apply_page")
  status            String   @default("new")
  adminNotes        String?  @map("admin_notes")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([city])
  @@index([preferredPackage])
  @@index([createdAt(sort: Desc)])
  @@map("franchise_leads")
}

// Brochure Downloads
model BrochureDownload {
  id           String   @id @default(uuid())
  name         String
  mobile       String
  city         String?
  downloadedAt DateTime @default(now()) @map("downloaded_at")

  @@map("brochure_downloads")
}

// Vendor Hubs
model VendorHub {
  id        String   @id @default(uuid())
  city      String
  state     String
  type      String
  tier      String
  address   String
  phone     String
  openHours String   @map("open_hours")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("vendor_hubs")
}

// Vendor Subscription & Payment Record
model VendorSubscription {
  id                String    @id @default(uuid())
  subscriptionId    String    @unique @map("subscription_id")
  applicationId     String    @map("application_id")
  vendorName        String    @map("vendor_name")
  vendorMobile      String    @map("vendor_mobile")
  vendorEmail       String?   @map("vendor_email")
  city              String
  state             String?
  
  // Package & Subscription Terms
  planTier          String    @map("plan_tier") // silver, gold, platinum
  planName          String    @map("plan_name")
  billingCycle      String    @default("One-Time Onboarding & Annual Licensing") @map("billing_cycle")
  status            String    @default("active") // active, pending, cancelled
  startDate         DateTime  @default(now()) @map("start_date")
  endDate           DateTime? @map("end_date")
  territoryScope    String?   @map("territory_scope")
  hasExclusivity    Boolean   @default(true) @map("has_exclusivity")
  
  // Cashfree Payment Details
  orderId           String    @unique @map("order_id")
  cfOrderId         String?   @map("cf_order_id")
  cfPaymentId       String?   @map("cf_payment_id")
  paymentSessionId  String?   @map("payment_session_id")
  paymentMethod     String?   @map("payment_method")
  paymentStatus     String    @default("pending") @map("payment_status") // PAID, ACTIVE, PENDING, FAILED
  baseAmount        Float     @map("base_amount")
  gatewayFee        Float     @default(0) @map("gateway_fee")
  gstAmount         Float     @default(0) @map("gst_amount")
  totalAmount       Float     @map("total_amount")
  currency          String    @default("INR")
  paidAt            DateTime? @map("paid_at")
  
  adminNotes        String?   @map("admin_notes")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([applicationId])
  @@index([orderId])
  @@index([status])
  @@index([paymentStatus])
  @@index([planTier])
  @@map("vendor_subscriptions")
}

// Plan Change & Support Tickets
model PlanChangeTicket {
  id              String    @id @default(uuid())
  ticketId        String    @unique @map("ticket_id")
  applicationId   String    @map("application_id")
  vendorName      String    @map("vendor_name")
  vendorMobile    String    @map("vendor_mobile")
  vendorEmail     String?   @map("vendor_email")
  currentPlan     String    @map("current_plan")
  requestedPlan   String    @map("requested_plan")
  reason          String?
  status          String    @default("PENDING") // PENDING, AWAITING_PAYMENT, PAYMENT_COMPLETED, COMPLETED, REJECTED
  adminNotes      String?   @map("admin_notes")
  upgradeAmount   Float?    @default(0) @map("upgrade_amount")
  gatewayFee      Float?    @default(0) @map("gateway_fee")
  gstAmount       Float?    @default(0) @map("gst_amount")
  totalAmount     Float?    @default(0) @map("total_amount")
  paymentStatus   String?   @default("UNPAID") @map("payment_status")
  paymentId       String?   @map("payment_id")
  paidAt          DateTime? @map("paid_at")
  newUserId       String?   @map("new_user_id")
  newPassword     String?   @map("new_password")
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([applicationId])
  @@index([status])
  @@map("plan_change_tickets")
}

// Vendor User / Auth Credentials
model VendorUser {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  password       String
  applicationId  String    @map("application_id")
  vendorName     String    @map("vendor_name")
  vendorMobile   String    @map("vendor_mobile")
  vendorEmail    String?   @map("vendor_email")
  currentPlan    String    @default("gold") @map("current_plan")
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([applicationId])
  @@map("vendor_users")
}